{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owsf.dev/schemas/v0.1/owsf-core.schema.json",
  "title": "OWSF Core Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owsf_version",
    "doc_id",
    "created_at",
    "producer",
    "spaces",
    "events"
  ],
  "properties": {
    "owsf_version": {
      "type": "string",
      "const": "0.1"
    },
    "doc_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_doc_id",
        "parent_event_id",
        "kind"
      ],
      "properties": {
        "parent_doc_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_event_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "manual",
            "handoff"
          ]
        }
      }
    },
    "writers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "writer_id"
        ],
        "properties": {
          "writer_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "spaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "parent",
          "boundary",
          "capabilities",
          "trust_level"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "parent": {
            "type": [
              "string",
              "null"
            ]
          },
          "boundary": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string"
              }
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "trust_level": {
            "type": "string",
            "enum": [
              "untrusted",
              "restricted",
              "trusted"
            ]
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "writer_id",
          "space_id",
          "type",
          "lamport",
          "seq",
          "timestamp",
          "payload"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "writer_id": {
            "type": "string",
            "minLength": 1
          },
          "space_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "lamport": {
            "type": "integer",
            "minimum": 0
          },
          "seq": {
            "type": "integer",
            "minimum": 0
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "payload": {
            "type": "object"
          },
          "meta": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "determinism"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "full",
            "partial"
          ]
        },
        "determinism": {
          "type": "string",
          "enum": [
            "full",
            "best_effort",
            "none"
          ]
        },
        "missing_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest_hash": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
